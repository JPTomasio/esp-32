# ---------------------------------------------------------------------------
# Credenciais da nuvem (Etapa 4)
# ---------------------------------------------------------------------------
#
# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase:
#
#     cp servidor/.env.exemplo servidor/.env
#
# O .env esta no .gitignore. NAO versione: este repositorio e publico e a
# chave service_role da acesso total ao banco.
#
# Onde encontrar os valores:
#   https://supabase.com -> seu projeto -> Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL" -- sem barra no final.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave "service_role". Fica somente aqui, no servidor Python: nunca vai para o
# navegador nem para o firmware do ESP32.
SUPABASE_KEY=cole_aqui_a_chave_service_role

# ---------------------------------------------------------------------------
# Aviso no celular (Etapa 5) -- opcional
# ---------------------------------------------------------------------------
#
# Sem estas duas variaveis o sistema roda igual: buzzer, dashboard e nuvem
# continuam funcionando, so nao chega mensagem no celular.
#
# Como obter, em dois minutos:
#
#   1. no Telegram, fale com o @BotFather -> /newbot -> escolha um nome.
#      Ele responde com o token, algo como 123456789:AAH...  -> TELEGRAM_TOKEN
#
#   2. mande qualquer mensagem para o bot que voce acabou de criar (o Telegram
#      nao deixa um bot escrever primeiro para alguem).
#
#   3. abra no navegador, trocando <token> pelo seu:
#        https://api.telegram.org/bot<token>/getUpdates
#      Procure "chat":{"id":987654321 -- esse numero e o TELEGRAM_CHAT_ID.
#      Para avisar o grupo todo, crie um grupo, coloque o bot dentro e use o
#      id do grupo (vem negativo, e normal).
#
# O token da controle total do bot: ele fica somente aqui, no servidor Python.
# ---------------------------------------------------------------------------

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo minimo entre dois avisos, em segundos. Evita encher o celular
# quando a pessoa entorta e endireita varias vezes seguidas.
# Opcional -- o padrao e 120.
#INTERVALO_NOTIFICACAO_S=120
