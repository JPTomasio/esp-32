# ---------------------------------------------------------------------------
# Credenciais da nuvem (Etapa 4)
# ---------------------------------------------------------------------------
#
# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase:
#
#     cp servidor/.env.exemplo servidor/.env
#
# O .env esta no .gitignore. NAO versione: este repositorio e publico e a
# chave service_role da acesso total ao banco.
#
# Onde encontrar os valores:
#   https://supabase.com -> seu projeto -> Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL" -- sem barra no final.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave "service_role". Fica somente aqui, no servidor Python: nunca vai para o
# navegador nem para o firmware do ESP32.
SUPABASE_KEY=cole_aqui_a_chave_service_role
